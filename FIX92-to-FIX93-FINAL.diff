+            EvidenceValue(e, "Endpoint"), EvidenceValue(e, "Host"), EvidenceValue(e, "Puerto"),
+            EvidenceValue(e, "Certificado"), EvidenceValue(e, "Thumbprint")
+        }.Where(x => !string.IsNullOrWhiteSpace(x)));
