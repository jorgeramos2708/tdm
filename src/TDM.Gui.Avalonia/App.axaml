<Application xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
              xmlns:conv="clr-namespace:TDM.Gui.Avalonia.Converters"
              x:Class="TDM.Gui.Avalonia.App"
              RequestedThemeVariant="Dark">
  <Application.Resources>
    <conv:BoolToGreenRedConverter x:Key="BoolToGreenRed" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#060C13" />
      <Setter Property="Foreground" Value="#EDF6FC" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1B3142" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="#08121C" />
      <Setter Property="BorderBrush" Value="#1B3142" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,8,10,12" />
    </Style>

    <Style Selector="Border.workspace-section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1B3142" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,10,12,16" />
    </Style>

    <Style Selector="Border.workspace-slice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#152A3A" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,10,20,16" />
    </Style>

    <Style Selector="Border.metric-strip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1B3142" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.metric-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#152A3A" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="86" />
    </Style>

    <Style Selector="TextBlock.hero-title">
      <Setter Property="Foreground" Value="#39D0FF" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.hero-subtitle">
      <Setter Property="Foreground" Value="#8FA3B8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="Foreground" Value="#39D0FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.panel-title">
      <Setter Property="Foreground" Value="#39D0FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="25" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8FA3B8" />
    </Style>

    <Style Selector="TextBlock.kpi-caption">
      <Setter Property="Foreground" Value="#8FA3B8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.value-strong">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.detail">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B8D5E8" />
      <Setter Property="BorderBrush" Value="#35556C" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.detail:pointerover">
      <Setter Property="Background" Value="#0B1B27" />
      <Setter Property="Foreground" Value="#39D0FF" />
    </Style>

    <Style Selector="Button.primary-action">
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="#1F334A" />
      <Setter Property="Foreground" Value="#F3FAFF" />
      <Setter Property="BorderBrush" Value="#3D5E85" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style Selector="Button.top-nav">
      <Setter Property="MinWidth" Value="136" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0F1B29" />
      <Setter Property="Foreground" Value="#EAF4FF" />
      <Setter Property="BorderBrush" Value="#365271" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.icon-nav">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#EAF4FF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.icon-ghost">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="Button.icon-nav /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.icon-nav:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#CAD5DF" />
      <Setter Property="Opacity" Value="0.48" />
    </Style>

    <Style Selector="Button.icon-nav:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon-nav:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon-ghost /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.icon-ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.icon-ghost:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="ComboBox.toolbar-combo">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="#0F1B29" />
      <Setter Property="Foreground" Value="#F1F6FD" />
      <Setter Property="BorderBrush" Value="#365271" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>

    <Style Selector="TabControl.main-tabs">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8BA2B5" />
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#EDF6FC" />
    </Style>



    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="#F5FAFF" />
      <Setter Property="Background" Value="#08111B" />
      <Setter Property="BorderBrush" Value="#94A8BC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,0" />
    </Style>



    <Style Selector="NumericUpDown.compact-number">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="NumericUpDown.compact-number /template/ TextBox#PART_TextBox">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="NumericUpDown TextBox">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="#F5FAFF" />
      <Setter Property="Background" Value="#08111B" />
      <Setter Property="BorderBrush" Value="#94A8BC" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="CheckBox.spaced-check">
      <Setter Property="Margin" Value="0,0,14,6" />
    </Style>
  </Application.Styles>
</Application>
