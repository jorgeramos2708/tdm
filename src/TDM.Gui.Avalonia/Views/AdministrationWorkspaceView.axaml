<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TDM.Gui.Avalonia.Views.AdministrationWorkspaceView">
  <StackPanel Spacing="10">
    <TextBlock Text="CONFIGURACIÓN" Classes="panel-title" />

    <Border Classes="card" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock Text="UMBRALES Y OPCIONES DE MONITOREO" Classes="section-title" />
        <Grid ColumnDefinitions="600,460,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,20,0">
            <Grid ColumnDefinitions="260,126,126">
              <TextBlock Text="Métrica" FontWeight="SemiBold" Classes="muted" />
              <TextBlock Grid.Column="1" Text="Advertencia" FontWeight="SemiBold" Foreground="#FFD166" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Crítico" FontWeight="SemiBold" Foreground="#FF4D4F" HorizontalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="CPU del servidor (%)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding CpuWarning}" Minimum="1" Maximum="100" Increment="1" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding CpuCritical}" Minimum="1" Maximum="100" Increment="1" FormatString="N0" /></Grid>
            <Grid Grid.Row="2" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Memoria usada (%)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding MemoryWarning}" Minimum="1" Maximum="100" Increment="1" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding MemoryCritical}" Minimum="1" Maximum="100" Increment="1" FormatString="N0" /></Grid>
            <Grid Grid.Row="3" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Sesiones con problema" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding SessionWarning}" Minimum="1" Maximum="100000" Increment="1" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding SessionCritical}" Minimum="1" Maximum="100000" Increment="1" FormatString="N0" /></Grid>
            <Grid Grid.Row="4" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Cambios en servicios" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding ServiceChangesWarning}" Minimum="1" Maximum="10000" Increment="1" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding ServiceChangesCritical}" Minimum="1" Maximum="10000" Increment="1" FormatString="N0" /></Grid>
            <Grid Grid.Row="5" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="CPU de TDM (%)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding TdmCpuWarning}" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="N1" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding TdmCpuCritical}" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="N1" /></Grid>
            <Grid Grid.Row="6" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Memoria de TDM (%)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding TdmRamWarning}" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="N1" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding TdmRamCritical}" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="N1" /></Grid>
            <Grid Grid.Row="7" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Recursos abiertos de TDM" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding TdmHandlesWarning}" Minimum="100" Maximum="1000000" Increment="100" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding TdmHandlesCritical}" Minimum="100" Maximum="1000000" Increment="100" FormatString="N0" /></Grid>
            <Grid Grid.Row="8" ColumnDefinitions="260,126,126" Margin="0,3,0,0"><TextBlock Text="Hilos de TDM" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="118" Value="{Binding TdmThreadsWarning}" Minimum="1" Maximum="100000" Increment="5" FormatString="N0" /><NumericUpDown Classes="compact-number" Grid.Column="2" Width="118" Value="{Binding TdmThreadsCritical}" Minimum="1" Maximum="100000" Increment="5" FormatString="N0" /></Grid>
          </Grid>

          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Ajustes operativos" FontWeight="SemiBold" Classes="muted" Margin="0,0,0,1" />
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Espera entre incidentes (seg)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding IncidentCooldownSeconds}" Minimum="10" Maximum="86400" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Lecturas sanas para recuperar" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding IncidentRecoverySamples}" Minimum="1" Maximum="20" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Tolerancia de reloj (seg)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding ClockDriftSeconds}" Minimum="1" Maximum="86400" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máximo atraso del nodo (seg)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding NodeStaleSeconds}" Minimum="30" Maximum="86400" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Tiempo sin datos del nodo (seg)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding NodeOfflineSeconds}" Minimum="31" Maximum="604800" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Tiempo máximo de lectura (seg)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding NodeReadTimeoutSeconds}" Minimum="2" Maximum="30" FormatString="N0" /></Grid>

            <StackPanel Spacing="2" Margin="0,5,0,0">
              <CheckBox Classes="spaced-check" Content="Reducir ruido de alertas" IsChecked="{Binding EnableIncidentAntiNoise}" />
              <CheckBox Classes="spaced-check" Content="Sincronizar lectura entre nodos" IsChecked="{Binding EnableSynchronizedCursor}" />
              <CheckBox Classes="spaced-check" Content="Habilitar vista Servidores/Granja" IsChecked="{Binding EnableMultiServer}" />
            </StackPanel>

            <TextBlock Text="Estabilidad de causa (anti-flapping)" FontWeight="SemiBold" Classes="muted" Margin="0,8,0,1" />
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Umbral causas distintas (2-5)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding CauseStabilityFlappingThreshold}" Minimum="2" Maximum="5" FormatString="N0" /></Grid>

            <TextBlock Text="Límites de logs TSplus (diagnóstico completo)" FontWeight="SemiBold" Classes="muted" Margin="0,8,0,1" />
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. archivos por directorio" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxFilesPerDirectory}" Minimum="50" Maximum="2000" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. bytes por archivo (bytes)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxBytesPerFile}" Minimum="1048576" Maximum="536870912" Increment="1048576" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Presupuesto total lectura (bytes)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxTotalBytes}" Minimum="10485760" Maximum="2147483648" Increment="10485760" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. eventos" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxEvents}" Minimum="100" Maximum="50000" FormatString="N0" /></Grid>

            <TextBlock Text="Límites de logs TSplus (incremental)" FontWeight="SemiBold" Classes="muted" Margin="0,8,0,1" />
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. archivos por directorio" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxFilesPerDirectoryIncremental}" Minimum="50" Maximum="1000" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. bytes por archivo (bytes)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxBytesPerFileIncremental}" Minimum="65536" Maximum="1048576" Increment="65536" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Presupuesto total lectura (bytes)" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxTotalBytesIncremental}" Minimum="262144" Maximum="16777216" Increment="262144" FormatString="N0" /></Grid>
            <Grid ColumnDefinitions="300,112"><TextBlock Text="Máx. eventos" VerticalAlignment="Center" /><NumericUpDown Classes="compact-number" Grid.Column="1" Width="104" Value="{Binding MaxEventsIncremental}" Minimum="50" Maximum="2000" FormatString="N0" /></Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
              <Button Classes="detail" Content="Valores predeterminados" Command="{Binding RestoreRecommendedCommand}" />
              <Button Classes="primary-action" Content="Guardar configuración" Command="{Binding SaveThresholdsCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="NOTIFICACIONES POR CORREO" Classes="section-title" />
                      </StackPanel>
          <CheckBox Grid.Column="1" Classes="spaced-check" Content="Habilitar correo" IsChecked="{Binding EmailEnabled}" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="1.15*,0.85*">
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="180,*,110" Margin="0,0,18,0">
            <TextBlock Text="Servidor SMTP" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding EmailSmtpHost}" Watermark="smtp.ejemplo.com" />
            <NumericUpDown Classes="compact-number" Grid.Column="2" Width="100" Value="{Binding EmailSmtpPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="N0" />

            <TextBlock Grid.Row="1" Text="Usuario SMTP" VerticalAlignment="Center" Margin="0,5,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmailUserName}" Margin="0,5,0,0" />
            <CheckBox Grid.Row="1" Grid.Column="2" Classes="spaced-check" Content="TLS" IsChecked="{Binding EmailUseTls}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" />

            <TextBlock Grid.Row="2" Text="Contraseña SMTP" VerticalAlignment="Center" Margin="0,5,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmailPassword}" PasswordChar="●" Watermark="Deje vacío para conservar la guardada" Margin="0,5,0,0" />
            <Button Grid.Row="2" Grid.Column="2" Classes="detail" Content="Borrar" Command="{Binding ClearEmailCredentialCommand}" Margin="8,5,0,0" />

            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding EmailPasswordState}" Classes="muted" FontSize="11" Margin="180,3,0,0" TextWrapping="Wrap" />
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*">
            <TextBlock Text="Remitente" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding EmailFromAddress}" Watermark="tdm@empresa.com" />
            <TextBlock Grid.Row="1" Text="Severidad mínima" VerticalAlignment="Center" Margin="0,5,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EmailSeverityOptions}" SelectedItem="{Binding EmailMinimumSeverity}" Margin="0,5,0,0" />
            <TextBlock Grid.Row="2" Text="Timeout (seg)" VerticalAlignment="Center" Margin="0,5,0,0" />
            <NumericUpDown Classes="compact-number" Grid.Row="2" Grid.Column="1" Width="110" Value="{Binding EmailTimeoutSeconds}" Minimum="3" Maximum="120" Increment="1" FormatString="N0" Margin="0,5,0,0" />
          </Grid>
        </Grid>

        <Grid ColumnDefinitions="1.3*,0.7*">
          <StackPanel Grid.Column="0" Spacing="3" Margin="0,2,18,0">
            <TextBlock Text="Destinatarios" FontWeight="SemiBold" />
            <TextBox Text="{Binding EmailRecipients}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" Watermark="soporte@empresa.com; infraestructura@empresa.com" />
            <TextBlock Text="Separe varias direcciones con punto y coma, coma o salto de línea. Máximo 50 destinatarios." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Enviar cuando" FontWeight="SemiBold" />
            <CheckBox Classes="spaced-check" Content="Se abre una alerta" IsChecked="{Binding EmailNotifyOpened}" />
            <CheckBox Classes="spaced-check" Content="Aumenta la severidad" IsChecked="{Binding EmailNotifyEscalated}" />
          </StackPanel>
        </Grid>

<StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="detail" Content="Enviar prueba" Command="{Binding SendTestEmailCommand}" />
              <Button Classes="primary-action" Content="Guardar correo" Command="{Binding SaveEmailSettingsCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

    <Border Classes="card" Padding="14" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="SIMULADOR DE REMEDIACIÓN (What-If)" Classes="section-title" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
          <TextBlock Text="Servicio objetivo:" VerticalAlignment="Center" Width="120" />
          <TextBox Grid.Column="1" Text="{Binding RemediationTargetService}" Watermark="ej: TSplus Web Portal, Spooler, W32Time..." Margin="0,0,8,0" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding RemediationActions}" SelectedItem="{Binding RemediationAction}" Width="160" Margin="0,0,8,0" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
            <Button Classes="primary-action" Content="Simular" Command="{Binding SimulateRemediationCommand}" />
            <Button Classes="detail" Content="Buscar mejor acción" Command="{Binding FindRemediationActionsCommand}" />
          </StackPanel>
        </Grid>

        <Border BorderBrush="#333" BorderThickness="0,1,0,0" Padding="0,6,0,0">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*">
            <TextBlock Text="Resultado:" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding RemediationResult}" FontWeight="Bold" Foreground="{Binding RemediationIsSafe, Converter={StaticResource BoolToGreenRed}}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{Binding RemediationAffectedCount}" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding RemediationSummary}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <TextBlock Text="Detalle de impacto por servicio:" FontWeight="SemiBold" Classes="muted" Margin="0,6,0,0" />
        <TextBlock Text="{Binding RemediationDetails}" FontFamily="fonts:Tdm#DejaVu Sans Mono" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
