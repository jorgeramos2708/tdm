<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TDM.Gui.Avalonia.ViewModels"
             xmlns:core="using:TDM.Core"
             xmlns:controls="using:TDM.Gui.Avalonia.Controls"
             x:Class="TDM.Gui.Avalonia.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Toolbar con filtros -->
    <Border Grid.Row="0" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <!-- Filtro por Nivel (Severidad) -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Nivel:" Classes="muted" VerticalAlignment="Center"/>
          <ComboBox Width="130"
                    ItemsSource="{Binding LevelFilterOptions}"
                    SelectedItem="{Binding SelectedLevelFilter}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Filtro por Sistema Origen -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Sistema:" Classes="muted" VerticalAlignment="Center"/>
          <ComboBox Width="150"
                    ItemsSource="{Binding SourceSystemFilterOptions}"
                    SelectedItem="{Binding SelectedSourceSystemFilter}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Búsqueda -->
        <TextBox Width="280" Watermark="Buscar en mensajes..." 
                 Text="{Binding SearchText, Mode=TwoWay}" 
                 VerticalAlignment="Center"/>

        <!-- Auto-scroll toggle -->
        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center"/>

        <!-- Botones -->
        <Button Classes="detail" Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center"/>
        <Button Classes="detail" Content="Limpiar logs" Command="{Binding ClearLogsCommand}" VerticalAlignment="Center"/>
        <Button Classes="primary-action" Content="Exportar" Command="{Binding ExportCommand}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Contadores -->
    <Border Grid.Row="1" Classes="toolbar" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}" Classes="muted" FontSize="11"/>
        <TextBlock Text="{Binding FilteredCount, StringFormat='Filtrados: {0}'}" Classes="muted" FontSize="11" Foreground="#39D0FF"/>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="20,0,0,0">
          <TextBlock Text="🔴 Crítico" Foreground="{x:Static vm:DashboardPalette.Danger}" FontSize="11"/>
          <TextBlock Text="🟠 Error" Foreground="{x:Static vm:DashboardPalette.Error}" FontSize="11"/>
          <TextBlock Text="🟡 Advertencia" Foreground="{x:Static vm:DashboardPalette.Warn}" FontSize="11"/>
          <TextBlock Text="⚪ Info" Foreground="{x:Static vm:DashboardPalette.Info}" FontSize="11"/>
          <TextBlock Text="⚫ Debug" Foreground="{x:Static vm:DashboardPalette.Muted}" FontSize="11"/>
          <Separator Margin="10,0" Width="1"/>
          <TextBlock Text="🟦 TSplus" Foreground="{x:Static vm:DashboardPalette.Cyan}" FontSize="11"/>
          <TextBlock Text="🟪 Windows" Foreground="{x:Static vm:DashboardPalette.Info}" FontSize="11"/>
          <TextBlock Text="🟣 Otros" Foreground="{x:Static vm:DashboardPalette.Violet}" FontSize="11"/>
          <TextBlock Text="❓ Desconocido" Foreground="{x:Static vm:DashboardPalette.Muted}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Lista de logs -->
    <Border Grid.Row="2" Classes="workspace-section" Margin="0,10,0,0" HorizontalAlignment="Stretch">
      <DockPanel>
        <!-- Cabecera fija de columnas; el margen izquierdo replica el borde de acento (3px) + padding (8px) de cada fila -->
        <StackPanel DockPanel.Dock="Top">
          <Grid ColumnDefinitions="20,96,72,80,140,*" Margin="11,2,8,3">
            <TextBlock Grid.Column="1" Text="HORA" Classes="muted" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="NIVEL" Classes="muted" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="SISTEMA" Classes="muted" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="COMPONENTE" Classes="muted" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="MENSAJE" Classes="muted" FontSize="10" FontWeight="SemiBold"/>
          </Grid>
          <Border Height="1" Background="#294057" Margin="11,0,8,0"/>
        </StackPanel>
        <ScrollViewer x:Name="LogScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding FilteredLogs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="3,0,0,0"
                        BorderBrush="{Binding RowAccent}"
                        Background="{Binding RowBackground}"
                        Padding="8,4" Margin="0,1,0,0"
                        ToolTip.Tip="{Binding FullDetail}">
                  <!-- Anchos fijos por columna para que todas las filas se alineen; el mensaje (columna *) se ajusta al panel -->
                  <Grid ColumnDefinitions="20,96,72,80,140,*">
                    <!-- Indicador de sistema origen -->
                    <Ellipse Grid.Column="0" Width="10" Height="10"
                             Fill="{Binding RowAccent}"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip.Tip="{Binding SourceSystemText}"/>

                    <!-- Timestamp -->
                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"
                               Classes="muted" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center"/>

                    <!-- Badge de nivel (severidad) -->
                    <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                            Background="{Binding LevelBrush}"
                            HorizontalAlignment="Center">
                      <TextBlock Text="{Binding LevelText}"
                                 FontSize="9" FontWeight="Bold"
                                 Foreground="Black" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Badge de sistema origen -->
                    <Border Grid.Column="3" Padding="6,2" CornerRadius="3"
                            Background="{Binding SourceSystemBrush}"
                            HorizontalAlignment="Center">
                      <TextBlock Text="{Binding SourceSystemText}"
                                 FontSize="9" FontWeight="Bold"
                                 Foreground="Black" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Componente (opcional) -->
                    <TextBlock Grid.Column="4" Text="{Binding Component}"
                               Classes="muted" FontSize="11" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Component}"/>

                    <!-- Mensaje -->
                    <TextBlock Grid.Column="5" Text="{Binding Message}"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="#EDF6FC" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>