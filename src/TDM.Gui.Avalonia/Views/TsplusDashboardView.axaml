<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TDM.Gui.Avalonia.Views.TsplusDashboardView">
  <StackPanel Spacing="12">
    <TextBlock Text="TSPLUS" Classes="panel-title" />
    <Border Classes="workspace-section">
      <Grid ColumnDefinitions="Auto,*"><StackPanel><TextBlock Classes="section-title" Text="SALUD GLOBAL"/><TextBlock Text="{Binding Overall}" Foreground="{Binding OverallAccent}" FontSize="24" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding OverallDetail}" Classes="muted" VerticalAlignment="Center" Margin="20,0,0,0" TextWrapping="Wrap"/></Grid>
    </Border>
    <Border Classes="workspace-section">
      <StackPanel Spacing="8">
        <TextBlock Classes="section-title" Text="SALUD FUNCIONAL POR MÓDULO"/>
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#203347" BorderThickness="0,0,0,1" Padding="0,8"><Grid ColumnDefinitions="250,150,*"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Accent}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
