<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TDM.Notifier.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,4"/></Style>
  </Application.Styles>
</Application>
